<Page x:Class="WpfApp8.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp8"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Выбор мест">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="20" 
                    Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                   
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,30,0">
                        <TextBlock Text="Фильм:" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="FilmNameTextBlock" 
                                   FontSize="16" 
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Дата:" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50"
                                       Margin="0,0,5,0"/>
                            <TextBlock x:Name="DateTextBlock" Foreground="#7F8C8D"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Время:" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50"
                                       Margin="0,0,5,0"/>
                            <TextBlock x:Name="TimeTextBlock" 
                                       Foreground="#E67E22"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Зал №:" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50"
                                       Margin="0,0,5,0"/>
                            <TextBlock x:Name="HallNumberTextBlock" Foreground="#7F8C8D"/>
                            <TextBlock Text=" (" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="RatingNameTextBlock" 
                                       Foreground="#3498DB"
                                       FontWeight="Bold"/>
                            <TextBlock Text=")" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </StackPanel>

                   
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Цена:" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"
                                   Margin="0,0,5,0"/>
                        <TextBlock x:Name="PriceTextBlock" 
                                   Foreground="#27AE60"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="15"
                    Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                   
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="20" Height="20" Background="White" BorderBrush="#2C3E50" BorderThickness="1" CornerRadius="3" Margin="0,0,5,0"/>
                            <TextBlock Text="Свободно" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="20" Height="20" Background="#3498DB" CornerRadius="3" Margin="0,0,5,0"/>
                            <TextBlock Text="Выбрано" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" Background="#E0E0E0" CornerRadius="3" Margin="0,0,5,0"/>
                            <TextBlock Text="Занято" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    
                    <Button Grid.Column="2" 
                            x:Name="ClearButton"
                            Content="Убрать все выбранные места" 
                            Click="ClearButton_Click"
                            Background="#E74C3C" 
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,8"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            
            <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="20"
                    Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Экран" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <Border Height="5" 
                            Background="#BDC3C7" 
                            CornerRadius="2" 
                            Margin="0,0,0,30"
                            Width="400"
                            HorizontalAlignment="Center"/>

                   
                    <ListBox x:Name="SeatsByRow" 
                             Background="Transparent" 
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    
                                    <TextBlock Text="{Binding RowNumber}" 
                                               FontWeight="Bold" 
                                               Foreground="#2C3E50"
                                               Width="30"
                                               VerticalAlignment="Center"/>
                                
                                    <ItemsControl ItemsSource="{Binding Seats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="40" 
                                                        Height="40"
                                                        Margin="5,0"
                                                        Padding="0"
                                                        BorderThickness="1"
                                                        BorderBrush="#BDC3C7"
                                                        Background="White"
                                                        Foreground="Black"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Click="SeatButton_Click"
                                                        Tag="{Binding}">
                                                    <TextBlock Text="{Binding SeatNumber}" 
                                                               HorizontalAlignment="Center"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
 
           
            <Border Grid.Row="3" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="20"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Выбрано мест: " 
                                   FontSize="16" 
                                   Foreground="#2C3E50"/>
                        <TextBlock x:Name="SelectedCountTextBlock" 
                                   Text="0" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#3498DB"
                                   Margin="0,0,20,0"/>
                        <TextBlock Text="Сумма: " 
                                   FontSize="16" 
                                   Foreground="#2C3E50"/>
                        <TextBlock x:Name="TotalPriceTextBlock" 
                                   Text="0 ₽" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#27AE60"/>
                    </StackPanel>

                   
                    <Button Grid.Column="1" 
                            x:Name="BookButton"
                            Content="Оформить билет" 
                            Click="BookButton_Click"
                            Background="#27AE60" 
                            Foreground="White"
                            BorderThickness="0"
                            Padding="25,12"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>