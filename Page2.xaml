<Page x:Class="Pr4.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница 2"
      Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Функция 2: a = { (f(x)+y)² - √(f(x)y), xy&gt;0; (f(x)+y)² + √(|f(x)y|), xy&lt;0; (f(x)+y)² + 1, xy=0 }" 
                       FontSize="14" FontWeight="Bold" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

         
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" 
                    Margin="0,0,0,20" Padding="10" HorizontalAlignment="Center">
                <Image Source="/Images/function2.png" Width="500" Height="150" 
                       ToolTip="Функция с условиями" Stretch="Uniform"/>
            </Border>

            <Grid Margin="0,0,0,20" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="x:" 
                           VerticalAlignment="Center" FontSize="14" Margin="5"
                           ToolTip="Введите значение x"/>
                <TextBox x:Name="txtX2" Grid.Row="0" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14"
                         ToolTip="Введите значение x"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="y:" 
                           VerticalAlignment="Center" FontSize="14" Margin="5"
                           ToolTip="Введите значение y"/>
                <TextBox x:Name="txtY2" Grid.Row="1" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14"
                         ToolTip="Введите значение y"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Результат a:" 
                           VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="5"
                           ToolTip="Результат вычисления"/>
                <TextBox x:Name="txtResult2" Grid.Row="2" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14" FontWeight="Bold"
                         IsReadOnly="True" Background="LightGray" Foreground="Blue"
                         ToolTip="Результат вычисления"/>
            </Grid>

            
            <GroupBox Header="Выберите функцию f(x)" Margin="0,10" Padding="10" 
                      HorizontalAlignment="Center" Width="400">
                <StackPanel>
                    <RadioButton x:Name="rbSh" Content="sh(x) - гиперболический синус" 
                                 Margin="5" GroupName="Function" IsChecked="True"
                                 ToolTip="sh(x) = (e^x - e^(-x))/2"/>
                    <RadioButton x:Name="rbX2" Content="x²" 
                                 Margin="5" GroupName="Function"
                                 ToolTip="x в квадрате"/>
                    <RadioButton x:Name="rbExp" Content="e^x" 
                                 Margin="5" GroupName="Function"
                                 ToolTip="Экспонента"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                <Button x:Name="btnCalculate2" Content="Вычислить" Width="120" Height="40" Margin="10" 
                        Background="LightGreen" FontSize="14" Click="btnCalculate2_Click"
                        ToolTip="Вычислить значение функции"/>
                <Button x:Name="btnClear2" Content="Очистить" Width="120" Height="40" Margin="10" 
                        Background="LightCoral" FontSize="14" Click="btnClear2_Click"
                        ToolTip="Очистить все поля"/>
            </StackPanel>

            <Border BorderBrush="Red" BorderThickness="1" CornerRadius="5" 
                    Margin="0,10" Padding="5" Background="#FFFFE0">
                <TextBlock x:Name="txtError2" TextWrapping="Wrap" 
                           Foreground="Red" FontSize="12" MinHeight="30"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>