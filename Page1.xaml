<Page x:Class="Pr4.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница 1"
      Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Функция 1: t = (2·cos(x-π/6))/(0.5+sin²y) · (1 + z²/(3-z²/5))" 
                       FontSize="16" FontWeight="Bold" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" 
                    Margin="0,0,0,20" Padding="10" HorizontalAlignment="Center">
                <Image Source="/Images/function1.png" Width="500" Height="150" 
                       ToolTip="Формула функции" Stretch="Uniform"/>
            </Border>

            <Grid Margin="0,0,0,20" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="x:" 
                           VerticalAlignment="Center" FontSize="14" Margin="5" 
                           ToolTip="Введите значение x"/>
                <TextBox x:Name="txtX" Grid.Row="0" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14" 
                         ToolTip="Введите значение x"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="y:" 
                           VerticalAlignment="Center" FontSize="14" Margin="5"
                           ToolTip="Введите значение y"/>
                <TextBox x:Name="txtY" Grid.Row="1" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14"
                         ToolTip="Введите значение y"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="z:" 
                           VerticalAlignment="Center" FontSize="14" Margin="5"
                           ToolTip="Введите значение z"/>
                <TextBox x:Name="txtZ" Grid.Row="2" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14"
                         ToolTip="Введите значение z"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Результат t:" 
                           VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="5"/>
                <TextBox x:Name="txtResult" Grid.Row="3" Grid.Column="1" 
                         Margin="5" Padding="5" FontSize="14" FontWeight="Bold"
                         IsReadOnly="True" Background="LightGray" Foreground="Blue"
                         ToolTip="Результат вычисления"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                <Button x:Name="btnCalculate" Content="Вычислить" 
                        Width="120" Height="40" Margin="10" 
                        Background="LightGreen" FontSize="14"
                        Click="btnCalculate_Click"
                        ToolTip="Вычислить значение функции"/>
                <Button x:Name="btnClear" Content="Очистить" 
                        Width="120" Height="40" Margin="10" 
                        Background="LightCoral" FontSize="14"
                        Click="btnClear_Click"
                        ToolTip="Очистить все поля"/>
            </StackPanel>

            <Border BorderBrush="Red" BorderThickness="1" CornerRadius="5" 
                    Margin="0,10" Padding="5" Background="#FFFFE0">
                <TextBlock x:Name="txtError" TextWrapping="Wrap" 
                           Foreground="Red" FontSize="12" MinHeight="30"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>