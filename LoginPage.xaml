<Page x:Class="WpfApp8.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход в систему">

    <Grid Background="#F5F5F5">
        <Border Width="400" Height="350" 
                Background="White" 
                CornerRadius="10" 
                BorderBrush="LightGray" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <StackPanel Margin="30">
               
                <TextBlock Text="Вход в систему" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#333333" 
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,20"/>


                <TextBlock Text="Логин:" Margin="0,0,0,5" Foreground="#666666"/>
                <TextBox x:Name="LoginTextBox" 
                        Height="35" 
                        Padding="10" 
                        BorderBrush="LightGray" 
                        BorderThickness="1"
                        Margin="0,0,0,15"/>

                <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="#666666"/>
                <PasswordBox x:Name="PasswordBox" 
                           Height="35" 
                           Padding="10" 
                           BorderBrush="LightGray" 
                           BorderThickness="1"
                           Margin="0,0,0,25"/>

                
                <Button x:Name="LoginButton" 
                       Content="Войти" 
                       Height="40" 
                       Background="#FF5694FF" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="14"
                       BorderThickness="0"
                       Margin="0,0,0,15"
                       Click="LoginButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

               
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Нет аккаунта? " Foreground="#666666"/>
                    <Button x:Name="RegisterLinkButton" 
                           Content="Зарегистрироваться" 
                           Background="Transparent" 
                           BorderThickness="0"
                           Foreground="#FF5694FF"
                           Cursor="Hand"
                           Click="RegisterLinkButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>