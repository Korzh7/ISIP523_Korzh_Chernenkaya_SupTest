<Page x:Class="WpfApp8.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp8"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="900"
      Title="Информация о фильме"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

           
            <Border Grid.Row="0" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="20" 
                    Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                
                    <Border Grid.Column="0" 
                            Height="400" 
                            Width="280" 
                            Background="#F0F0F0" 
                            CornerRadius="5"
                            HorizontalAlignment="Center"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Image Source="{Binding CurrentCinema.Image}" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               MaxHeight="390"
                               MaxWidth="270"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CurrentCinema.Name}" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="#F39C12" 
                                    CornerRadius="5" 
                                    Padding="15,8"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★ " Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentCinema.Rating, StringFormat={}{0:F1}}" 
                                               Foreground="White" 
                                               FontSize="18" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#3498DB" 
                                    CornerRadius="5" 
                                    Padding="15,8">
                                <TextBlock Text="{Binding CurrentCinema.AgeRating.Name}" 
                                           Foreground="White" 
                                           FontSize="14" 
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Жанры:" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding CurrentCinema.GenresCinema}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#ECF0F1" 
                                                CornerRadius="15" 
                                                Padding="10,5"
                                                Margin="0,0,8,5">
                                            <TextBlock Text="{Binding Genres.Name}" 
                                                       Foreground="#2C3E50" 
                                                       FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="О фильме:" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CurrentCinema.Description}" 
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="#7F8C8D"
                                       LineHeight="20"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="20"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Сеансы" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,20"/>

                    <ListBox x:Name="SessionsListBox" 
                             ItemsSource="{Binding Sessions}"
                             Background="Transparent" 
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SessionsListBox_SelectionChanged">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" 
                                        CornerRadius="8" 
                                        Padding="15"
                                        Margin="0,0,0,10"
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding DateTime, StringFormat='dd.MM.yyyy'}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Foreground="#2C3E50"/>
                                        </StackPanel>

                                       
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding DateTime, StringFormat='HH:mm'}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Foreground="#E67E22"/>
                                        </StackPanel>

                                      
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="Зал №" Foreground="#7F8C8D"/>
                                            <TextBlock Text="{Binding HallNumber}" 
                                                       FontWeight="Bold" 
                                                       Foreground="#2C3E50"
                                                       Margin="0,0,10,0"/>

                                            <Border Background="#95A5A6" 
                                                    CornerRadius="12" 
                                                    Padding="8,3">
                                                <TextBlock Text="{Binding RatingName}" 
                                                           Foreground="White" 
                                                           FontSize="11" 
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                       
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ChairPrice, StringFormat={}{0} ₽}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Foreground="#27AE60"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="за место" 
                                                       Foreground="#7F8C8D"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RatingName}" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="200"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="NoSessionsBorder" 
                            Visibility="Collapsed"
                            Background="#F8F9FA" 
                            CornerRadius="8" 
                            Padding="30"
                            Margin="0,10,0,0"
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Нет доступных сеансов" 
                                       FontSize="16" 
                                       Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>