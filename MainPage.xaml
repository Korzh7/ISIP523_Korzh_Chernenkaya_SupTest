<Page x:Class="WpfApp8.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp8"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Главная страница">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Сортировать:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <RadioButton x:Name="NameSortRadio" Content="По названию" Margin="0,0,10,0" Checked="NameSort_Checked"/>
            <RadioButton x:Name="RatingSortRadio" Content="По рейтингу" Checked="RatingSort_Checked"/>
        </StackPanel>

       
        <StackPanel Grid.Row="0" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <TextBox x:Name="SearchTextBox" 
                     Width="200" 
                     Height="30"
                     Padding="5"
                     Margin="0,0,10,0"
                     TextChanged="SearchTextBox_TextChanged"/>

            <Button x:Name="ClearButton" 
                    Content="Сбросить" 
                    Click="ClearButton_Click" 
                    Width="70" 
                    Height="30"
                    Background="#E74C3C" 
                    Foreground="White"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

       
        <ListBox x:Name="CinemaListBox" 
                 Grid.Row="1" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionChanged="CinemaListBox_SelectionChanged">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            Margin="5" 
                            Padding="10" 
                            Background="White"
                            CornerRadius="5"
                            Width="220">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" Opacity="0.2" ShadowDepth="2"/>
                        </Border.Effect>

                        <StackPanel>
                            
                            <Border Height="150" 
                                    Margin="0,0,0,10" 
                                    Background="#F0F0F0" 
                                    CornerRadius="3">
                                <Image Source="{Binding Image}" 
                                       Stretch="Uniform" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Height="140"
                                       Width="200"/>
                            </Border>

                            
                            <TextBlock Text="{Binding Name}" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       TextAlignment="Center" 
                                       Margin="0,5"
                                       TextWrapping="Wrap"
                                       MaxHeight="40"/>

                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                <TextBlock Text="Рейтинг: " Foreground="#666666"/>
                                <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" 
                                           Foreground="#F39C12" 
                                           FontWeight="Bold"/>
                                <TextBlock Text="/10" Foreground="#666666"/>
                            </StackPanel>

                           
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                <TextBlock Text="С: " Foreground="#666666"/>
                                <TextBlock Text="{Binding DateStart, StringFormat='dd.MM.yyyy'}" 
                                           Foreground="#27AE60"/>
                            </StackPanel>

                           
                            <Border Background="#3498DB" 
                                    CornerRadius="3" 
                                    Padding="5"
                                    Margin="0,5"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AgeRating.Name}" 
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           FontSize="11"/>
                            </Border>

                            
                            <ItemsControl ItemsSource="{Binding GenresCinema}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Genres.Name}" 
                                                   Margin="0,0,5,0"
                                                   FontStyle="Italic"
                                                   Foreground="#7F8C8D"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>