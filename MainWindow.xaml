<Window x:Class="Pr4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа 4 Иванов Петров" 
        Height="550" Width="950"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="LightSteelBlue" Height="30">
            <MenuItem Header="_Навигация">
                <MenuItem Header="Страница 1" Click="Page1_Click"/>
                <MenuItem Header="Страница 2" Click="Page2_Click"/>
                <MenuItem Header="Страница 3" Click="Page3_Click"/>
            </MenuItem>
            <MenuItem Header="_Выход" Click="Exit_Click"/>
        </Menu>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>